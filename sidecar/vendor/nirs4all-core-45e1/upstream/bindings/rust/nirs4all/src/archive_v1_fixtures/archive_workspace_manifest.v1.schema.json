{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/contracts/archive-v1/archive_workspace_manifest.v1.schema.json",
  "title": "nirs4all ZIP archive and workspace snapshot V1 (SAVE-001)",
  "description": "Frozen V1 dispatch manifest for a future nirs4all-core writer. It is not the historical nirs4all .n4a manifest and it does not implement a reader or writer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "archive_id", "persistence_kind", "writer", "reader_dispatch", "physical_profile", "replay", "payloads", "member_inventory", "migration_provenance", "security", "workspace"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "nirs4all.archive_workspace.v1"},
    "archive_id": {"$ref": "#/$defs/id"},
    "persistence_kind": {"enum": ["n4a_archive", "workspace_snapshot"]},
    "writer": {"type": "object", "additionalProperties": false, "required": ["product_aggregate_owner", "canonical_writer_id"], "properties": {"product_aggregate_owner": {"const": "nirs4all-core"}, "canonical_writer_id": {"const": "nirs4all-core.archive_workspace_writer.v1"}}},
    "reader_dispatch": {"type": "object", "additionalProperties": false, "required": ["archive_v1", "legacy_n4a"], "properties": {
      "archive_v1": {"type": "object", "additionalProperties": false, "required": ["accepted_versions", "future_versions", "dispatch_before_extraction"], "properties": {"accepted_versions": {"const": [1]}, "future_versions": {"const": "refuse"}, "dispatch_before_extraction": {"const": true}}},
      "legacy_n4a": {"type": "object", "additionalProperties": false, "required": ["form", "manifest_member", "reader_id", "maximum_bundle_format_version", "migration_direction"], "properties": {"form": {"const": "historical_n4a_zip"}, "manifest_member": {"const": "manifest.json"}, "reader_id": {"const": "nirs4all.pipeline.bundle.loader.BundleLoader"}, "maximum_bundle_format_version": {"const": "1.0"}, "migration_direction": {"const": "legacy_to_v1_copy_on_write_only"}}}
    }},
    "physical_profile": {"type": "object", "additionalProperties": false, "required": ["container", "manifest_member", "regular_files_only", "limits"], "properties": {
      "container": {"const": "zip"}, "manifest_member": {"const": "manifest.json"}, "regular_files_only": {"const": true},
      "limits": {"type": "object", "additionalProperties": false, "required": ["max_entries", "max_total_uncompressed_bytes", "max_member_uncompressed_bytes", "max_compression_ratio"], "properties": {"max_entries": {"const": 256}, "max_total_uncompressed_bytes": {"const": 536870912}, "max_member_uncompressed_bytes": {"const": 134217728}, "max_compression_ratio": {"const": 100}}}
    }},
    "replay": {"type": "object", "additionalProperties": false, "required": ["portable_predictor_package", "training_artifacts", "future_artifacts"], "properties": {
      "portable_predictor_package": {"$ref": "#/$defs/portable_predictor_package_ref"},
      "training_artifacts": {"type": "object", "additionalProperties": false, "required": ["graph", "execution_bundle", "training_outcome", "prediction_cache_payload_set", "score_set"], "properties": {"graph": {"$ref": "#/$defs/graph_ref"}, "execution_bundle": {"$ref": "#/$defs/execution_bundle_ref"}, "training_outcome": {"$ref": "#/$defs/training_outcome_ref"}, "prediction_cache_payload_set": {"$ref": "#/$defs/prediction_cache_payload_set_ref"}, "score_set": {"$ref": "#/$defs/score_set_ref"}}},
      "future_artifacts": {"type": "array", "items": {"$ref": "#/$defs/deferred_artifact"}}
    }},
    "payloads": {"type": "object", "additionalProperties": false, "required": ["methods", "n4d_aggregate_reference", "conformal", "robustness", "host_artifacts"], "properties": {
      "methods": {"type": "object", "additionalProperties": false, "required": ["n4mm", "n4mopt"], "properties": {"n4mm": {"type": "array", "items": {"$ref": "#/$defs/n4mm_ref"}}, "n4mopt": {"type": "array", "items": {"$ref": "#/$defs/n4mopt_ref"}}}},
      "n4d_aggregate_reference": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/n4d_aggregate_reference"}]},
      "conformal": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/conformal_ref"}]},
      "robustness": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/robustness_ref"}]},
      "host_artifacts": {"type": "array", "items": {"$ref": "#/$defs/host_artifact"}}
    }},
    "member_inventory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/member"}},
    "migration_provenance": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/migration_provenance"}]},
    "security": {"type": "object", "additionalProperties": false, "required": ["integrity_profile", "signature"], "properties": {"integrity_profile": {"const": "sha256_raw_member_inventory_v1"}, "signature": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/signature"}]}}},
    "workspace": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/workspace_snapshot"}]},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "allOf": [
    {"if": {"properties": {"persistence_kind": {"const": "n4a_archive"}}, "required": ["persistence_kind"]}, "then": {"properties": {"workspace": {"type": "null"}}}},
    {"if": {"properties": {"persistence_kind": {"const": "workspace_snapshot"}}, "required": ["persistence_kind"]}, "then": {"properties": {"workspace": {"$ref": "#/$defs/workspace_snapshot"}}}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "member_path": {"type": "string", "minLength": 1, "maxLength": 512},
    "member": {"type": "object", "additionalProperties": false, "required": ["path", "regular_file", "raw_sha256", "uncompressed_size_bytes", "semantic_fingerprint", "semantic_profile"], "properties": {"path": {"$ref": "#/$defs/member_path"}, "regular_file": {"const": true}, "raw_sha256": {"$ref": "#/$defs/sha256"}, "uncompressed_size_bytes": {"type": "integer", "minimum": 0}, "semantic_fingerprint": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "semantic_profile": {"enum": ["dagml_tcv1", "dagml_historical_serde_json_v1", "methods_rfc8785_jcs", "host_opaque", "none"]}}},
    "member_ref": {"type": "object", "required": ["member_path", "raw_sha256", "semantic_fingerprint", "semantic_profile"], "properties": {"member_path": {"$ref": "#/$defs/member_path"}, "raw_sha256": {"$ref": "#/$defs/sha256"}, "semantic_fingerprint": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "semantic_profile": {"enum": ["dagml_tcv1", "dagml_historical_serde_json_v1", "methods_rfc8785_jcs", "host_opaque", "none"]}}},
    "dagml_v1_ref_base": {"allOf": [{"$ref": "#/$defs/member_ref"}, {"type": "object", "required": ["owner", "schema_id", "schema_version"], "properties": {"owner": {"const": "dag-ml"}, "schema_id": {"type": "string"}, "schema_version": {"const": 1}, "semantic_fingerprint": {"$ref": "#/$defs/sha256"}}}]},
    "dagml_v2_replay_ref_base": {"allOf": [{"$ref": "#/$defs/member_ref"}, {"type": "object", "required": ["owner", "schema_id", "schema_version", "producer_port_required"], "properties": {"owner": {"const": "dag-ml"}, "schema_id": {"type": "string"}, "schema_version": {"const": 2}, "producer_port_required": {"const": true}, "semantic_fingerprint": {"$ref": "#/$defs/sha256"}}}]},
    "portable_predictor_package_ref": {"allOf": [{"$ref": "#/$defs/dagml_v1_ref_base"}, {"type": "object", "properties": {"schema_id": {"const": "https://github.com/GBeurier/dag-ml/schemas/portable_predictor_package.v1.schema.json"}, "semantic_profile": {"const": "dagml_tcv1"}}}]},
    "graph_ref": {"allOf": [{"$ref": "#/$defs/dagml_v1_ref_base"}, {"type": "object", "properties": {"schema_id": {"const": "https://github.com/GBeurier/dag-ml/schemas/graph_spec.v1.schema.json"}, "semantic_profile": {"const": "dagml_historical_serde_json_v1"}}}]},
    "execution_bundle_ref": {"allOf": [{"$ref": "#/$defs/dagml_v2_replay_ref_base"}, {"type": "object", "properties": {"schema_id": {"const": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json"}, "semantic_profile": {"const": "dagml_tcv1"}}}]},
    "training_outcome_ref": {"allOf": [{"$ref": "#/$defs/dagml_v2_replay_ref_base"}, {"type": "object", "properties": {"schema_id": {"const": "https://github.com/GBeurier/dag-ml/schemas/training_outcome.v2.schema.json"}, "semantic_profile": {"const": "dagml_tcv1"}}}]},
    "prediction_cache_payload_set_ref": {"allOf": [{"$ref": "#/$defs/dagml_v2_replay_ref_base"}, {"type": "object", "properties": {"schema_id": {"const": "https://github.com/GBeurier/dag-ml/schemas/prediction_cache_payload_set.v2.schema.json"}, "semantic_profile": {"const": "dagml_historical_serde_json_v1"}}}]},
    "score_set_ref": {"allOf": [{"$ref": "#/$defs/dagml_v2_replay_ref_base"}, {"type": "object", "properties": {"schema_id": {"const": "https://github.com/GBeurier/dag-ml/schemas/score_set.v2.schema.json"}, "semantic_profile": {"const": "dagml_historical_serde_json_v1"}}}]},
    "n4mm_ref": {"allOf": [{"$ref": "#/$defs/member_ref"}, {"type": "object", "required": ["kind", "owner", "format_version", "abi_major"], "properties": {"kind": {"const": "N4MM"}, "owner": {"const": "nirs4all-methods"}, "format_version": {"const": 1}, "abi_major": {"const": 2}, "semantic_fingerprint": {"$ref": "#/$defs/sha256"}, "semantic_profile": {"const": "methods_rfc8785_jcs"}}}]},
    "n4mopt_ref": {"allOf": [{"$ref": "#/$defs/member_ref"}, {"type": "object", "required": ["kind", "owner", "format_version", "abi_major"], "properties": {"kind": {"const": "N4MOPT"}, "owner": {"const": "nirs4all-methods"}, "format_version": {"const": 1}, "abi_major": {"const": 2}, "semantic_fingerprint": {"$ref": "#/$defs/sha256"}, "semantic_profile": {"const": "methods_rfc8785_jcs"}}}]},
    "n4d_aggregate_reference": {"allOf": [{"$ref": "#/$defs/member_ref"}, {"type": "object", "required": ["kind", "owner", "interpretation"], "properties": {"kind": {"const": "n4d_aggregate_reference"}, "owner": {"const": "nirs4all-core"}, "interpretation": {"const": "aggregate_reference_not_n4d_format_claim"}, "semantic_profile": {"const": "none"}, "semantic_fingerprint": {"type": "null"}}}]},
    "conformal_ref": {"allOf": [{"$ref": "#/$defs/dagml_v1_ref_base"}, {"type": "object", "properties": {"schema_id": {"const": "https://github.com/GBeurier/dag-ml/schemas/conformal_calibration.v1.schema.json"}, "semantic_profile": {"const": "dagml_tcv1"}}}]},
    "robustness_ref": {"allOf": [{"$ref": "#/$defs/dagml_v1_ref_base"}, {"type": "object", "properties": {"schema_id": {"const": "https://github.com/GBeurier/dag-ml/schemas/robustness_report.v1.schema.json"}, "semantic_profile": {"const": "dagml_tcv1"}}}]},
    "host_artifact": {"allOf": [{"$ref": "#/$defs/member_ref"}, {"type": "object", "required": ["artifact_id", "host_state", "serialization_backend", "load_policy", "controller_id", "controller_version", "plugin_id", "plugin_version", "runtime_id", "abi_id", "capability_id"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "host_state": {"enum": ["native_portable", "host_sidecar"]}, "serialization_backend": {"enum": ["onnx", "safetensors", "json", "torch_state_dict", "joblib", "pickle", "rds"]}, "load_policy": {"enum": ["native_portable", "host_opt_in"]}, "controller_id": {"$ref": "#/$defs/id"}, "controller_version": {"$ref": "#/$defs/id"}, "plugin_id": {"$ref": "#/$defs/id"}, "plugin_version": {"$ref": "#/$defs/id"}, "runtime_id": {"$ref": "#/$defs/id"}, "abi_id": {"$ref": "#/$defs/id"}, "capability_id": {"$ref": "#/$defs/id"}, "semantic_profile": {"const": "host_opaque"}, "semantic_fingerprint": {"type": "null"}}}]},
    "deferred_artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "status", "reason", "affects_replay"], "properties": {"kind": {"$ref": "#/$defs/id"}, "status": {"const": "deferred_future_contract"}, "reason": {"type": "string", "minLength": 1}, "affects_replay": {"const": false}}},
    "migration_provenance": {"type": "object", "additionalProperties": false, "required": ["source_raw_sha256", "legacy_format", "legacy_format_version", "tool_id", "tool_version", "copy_on_write", "source_retained"], "properties": {"source_raw_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "legacy_format": {"anyOf": [{"type": "null"}, {"const": "historical_n4a_zip"}]}, "legacy_format_version": {"type": ["string", "null"]}, "tool_id": {"$ref": "#/$defs/id"}, "tool_version": {"$ref": "#/$defs/id"}, "copy_on_write": {"const": true}, "source_retained": {"const": true}}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["status", "manifest_sha256", "canonical_profile", "preimage_rules", "algorithm", "key_id", "signature", "trust_root"], "properties": {"status": {"const": "reserved_future_contract"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "canonical_profile": {"const": "archive_v1_manifest_json_canonical_v1"}, "preimage_rules": {"const": "utf8_json_sort_keys_compact_with_signature_null_v1"}, "algorithm": {"type": "null"}, "key_id": {"type": "null"}, "signature": {"type": "null"}, "trust_root": {"type": "null"}}},
    "workspace_payload": {"allOf": [{"$ref": "#/$defs/member_ref"}, {"type": "object", "additionalProperties": false, "required": ["kind", "run_id", "member_path", "raw_sha256", "semantic_fingerprint", "semantic_profile"], "properties": {"kind": {"enum": ["sqlite", "parquet", "artifact", "ordinary"]}, "run_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}, "member_path": {"$ref": "#/$defs/member_path"}, "raw_sha256": {"$ref": "#/$defs/sha256"}, "semantic_fingerprint": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "semantic_profile": {"enum": ["host_opaque", "none"]}}}]},
    "workspace_snapshot": {"type": "object", "additionalProperties": false, "required": ["layout", "snapshot_protocol", "payload_inventory", "exclusions"], "properties": {"layout": {"const": "sqlite_parquet_artifacts_v1"}, "snapshot_protocol": {"type": "object", "additionalProperties": false, "required": ["checkpoint_id", "transaction_id", "run_ids", "inventory_complete"], "properties": {"checkpoint_id": {"$ref": "#/$defs/id"}, "transaction_id": {"$ref": "#/$defs/id"}, "run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "inventory_complete": {"const": true}}}, "payload_inventory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/workspace_payload"}}, "exclusions": {"const": ["workspace/.session.lock", "workspace/live-session/**"]}}},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}, "additionalProperties": {"type": "object"}}
  }
}
