[package]
name = "n4m"
version = "0.1.4"
edition = "2021"
rust-version = "1.77"
license = "CECILL-2.1 OR AGPL-3.0-or-later"
description = "Official thin Rust binding for the libn4m C ABI"
repository = "https://github.com/GBeurier/nirs4all-methods"
categories = ["api-bindings", "science"]
keywords = ["nirs", "chemometrics", "ffi"]
build = "build.rs"
include = [
    "Cargo.toml",
    "README.md",
    "LICENSES/AGPL-3.0-or-later.txt",
    "LICENSES/CeCILL-2.1.txt",
    "abi_probe.c",
    "build.rs",
    "scripts/run_sanitized_tests.sh",
    "src/**",
]

[lib]
crate-type = ["rlib"]

[features]
default = ["linked"]
# Development and CI retain the existing link-time ABI verification path.
linked = []
# Distribution consumers load an explicitly selected libn4m at runtime.  This
# keeps the public safe API while removing N4M_LIB_DIR from their build path.
dynamic = ["dep:libloading"]

[lints.rust]
unsafe_op_in_unsafe_fn = "deny"

[build-dependencies]
cc = "1.1"

[dependencies]
libloading = { version = "0.8", optional = true }

[dev-dependencies]
static_assertions = "1.1"
