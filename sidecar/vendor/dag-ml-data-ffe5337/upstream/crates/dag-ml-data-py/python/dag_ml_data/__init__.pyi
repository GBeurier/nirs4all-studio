from os import PathLike
from typing import Any, Self

class DagMlDataError(Exception):
    category: str
    code: str
    severity: str
    remediation_hint: str
    context: dict[str, Any]
    context_json: str
    descriptor_json: str

class DagMlDataValidationError(DagMlDataError): ...
class DagMlDataContractError(DagMlDataError): ...
class DagMlDataCompatibilityError(DagMlDataError): ...

__version__: str

class JsonContract:
    def __init__(self, value: Any) -> None: ...
    @classmethod
    def from_path(cls, path: str | PathLike[str]) -> Self: ...
    def json(self) -> str: ...
    def to_dict(self) -> Any: ...

class DatasetSchema(JsonContract):
    def fingerprint(self) -> str: ...

class ModelInputSpec(JsonContract): ...
class AdapterRegistry(JsonContract): ...

class DataPlan(JsonContract):
    def fingerprint(self) -> str: ...

class SampleRelationTable(JsonContract):
    def fingerprint(self) -> str: ...

class FoldSet(JsonContract):
    def fingerprint(self) -> str: ...
    def validate_against(self, sample_relations: Any) -> None: ...

class CoordinatorDataPlanEnvelope(JsonContract): ...

