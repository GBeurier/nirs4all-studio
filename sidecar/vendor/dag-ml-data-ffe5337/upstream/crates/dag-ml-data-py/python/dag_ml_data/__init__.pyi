def contract_manifest_json() -> str: ...
def builtin_data_models_json() -> str: ...
def builtin_data_models() -> list[dict[str, Any]]: ...
def builtin_representations_json() -> str: ...
def builtin_representations() -> list[dict[str, Any]]: ...
def builtin_adapter_registry_json() -> str: ...
def builtin_adapter_registry() -> AdapterRegistry: ...
def tabular_numeric_model_input_spec_json() -> str: ...
def tabular_numeric_model_input_spec() -> ModelInputSpec: ...
def validate_dataset_schema_json(json: str) -> None: ...
def dataset_schema_fingerprint_json(json: str) -> str: ...
def validate_model_input_spec_json(json: str) -> None: ...
def validate_adapter_registry_json(json: str) -> None: ...
def plan_model_input_json(
