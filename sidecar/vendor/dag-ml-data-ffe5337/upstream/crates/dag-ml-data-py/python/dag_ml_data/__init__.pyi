def validate_data_plan_json(json: str) -> None: ...
def data_plan_fingerprint_json(json: str) -> str: ...
def validate_sample_relation_table_json(json: str) -> None: ...
def sample_relation_table_fingerprint_json(json: str) -> str: ...
