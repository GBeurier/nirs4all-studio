  "schema_version": 1,
  "sources": [
    {
      "id": "x",
      "input": [
        "nir.csv",
        "mir.csv"
      ],
      "key": "id",
      "merge": "concat_features",
      "params": {
        "na": {
          "fill": {
            "per_column": true
          },
          "policy": "auto"
        }
      },
      "role": "features"
    },
    {
      "id": "y",
      "input": "y.csv",
      "join": {
        "cardinality": "1:1",
        "coverage": "complete",
        "left": "y",
        "left_on": "id",
        "right": "x",
        "right_on": "id"
      },
      "params": {
        "na": {
          "fill": {
            "per_column": true
          },
          "policy": "auto"
        }
      },
      "role": "targets"
