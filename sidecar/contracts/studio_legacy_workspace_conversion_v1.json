{
  "schema_id": "nirs4all.studio-legacy-workspace-conversion.v1",
  "schema_version": 1,
  "owner": "studio-sidecar-rust",
  "routes": {
    "transition_status": "GET /api/workspace/transition-status",
    "convert": "POST /api/workspace/legacy-convert",
    "query_parameters": "forbidden"
  },
  "workspace_selection": "active_persisted_linked_workspace",
  "detection": {
    "owner": "rust",
    "deep_legacy_parsing": "forbidden",
    "bounded_run_tree_entries": 4096,
    "formats": [
      "duckdb-workspace",
      "legacy-arrays-directory",
      "sqlite-workspace-legacy-arrays",
      "sqlite-workspace-unreadable-or-incompatible",
      "fs-runs-legacy",
      "fs-runs-v2",
      "loose-predictions",
      "n4a-bundle",
      "n4a-py-bundle",
      "native-results-v1",
      "sqlite-workspace-v2",
      "new-or-empty"
    ],
    "sqlite_read": "immutable_read_only_uri",
    "strict_v2": "integrity_ok_user_version_2_all_7_tables_required_columns_no_live_journal",
    "native_results_triplet_scope": "active_root_and_direct_child_directories",
    "symlink_policy": "symlink_metadata_rejects_live_or_dangling_root_marker_and_every_encountered_subtree_entry"
  },
  "converter": {
    "owner": "nirs4all-tools",
    "transport": "bounded_stdio_process",
    "python_http": "forbidden",
    "module": "nirs4all_tools",
    "cli": "python -I -B -c <same-process-attest-and-runpy-bootstrap> -- legacy migrate",
    "spawn_identity_binding": "the interpreter regular-file SHA-256 captured from the packaged-qualified host is rechecked around every preflight and immediately before spawn; the launched interpreter then repeats the exact wheel, RECORD, manifest, DuckDB, and PyArrow functional attestation before runpy executes nirs4all_tools in that same process",
    "qualified_identity": {
      "source_commit": "88c2bc1e29603049cdbf1a1080a35845edf2f3c9",
      "version": "0.0.7",
      "wheel_sha256": "4f1c2e65ba42af9dc807e0704b7c6ec6b80efc22169d43f8051ae47f679cd819",
      "record_sha256": "2da8a3c2797eee9b9c8399620dd0734f5b2f829fc5015cb903db267ac3690238",
      "installed_manifest_sha256": "cd0311a57c4be4cd99f84b8ae750eb2f97d4edf765bb0e8717a9ea181724ae07",
      "readers": {
        "duckdb": {
          "version": "1.5.5",
          "functional_probe": "in-memory-select-40-plus-2"
        },
        "pyarrow": {
          "version": "25.0.1",
          "functional_probe": "in-memory-round-trip"
        }
      }
    },
    "capability_gate": "startup_exact_wheel_record_manifest_and_functional_reader_attestation",
    "execution_gate": "runtime_rechecks_attestation_immediately_before_every_spawn",
    "target": "nirs4all-workspace-v2",
    "maximum_concurrent_processes": 1,
    "timeout_seconds": 1800,
    "stdout_limit_bytes": 262144,
    "stderr_limit_bytes": 262144,
    "process_tree_termination": "unix_process_group_and_windows_internal_launcher_job_object",
    "windows_job_policy": "launcher_assigns_itself_before_python_spawn_kill_on_close_no_breakaway",
    "reader_cleanup_timeout_seconds": 2,
    "cleanup_failure_policy": "return_failure_and_permanently_poison_converter_instance",
    "unbounded_reader_join": "forbidden",
    "source_mutation": "forbidden",
    "output_policy": "fresh_disjoint_directory_owned_by_tools"
  },
  "request": {
    "allowed_fields": [
      "output_path",
      "verify",
      "dry_run",
      "strict",
      "link_converted_workspace"
    ],
    "unknown_fields": "reject",
    "unknown_fields_python_parity_exception": "approved_fail_closed_native_allowlist",
    "output_path": "absolute_bounded_path_or_default_sibling",
    "dry_run_activation": "forbidden"
  },
  "exit_codes": {
    "0": {
      "meaning": "verified_conversion_without_warnings_or_successful_dry_run",
      "http_status": 200,
      "automatic_activation": "only_after_requested_verify"
    },
    "10": {
      "meaning": "best_effort_opaque_preservation",
      "http_status": 200,
      "automatic_activation": "forbidden"
    },
    "20": {
      "meaning": "unsupported_input",
      "http_status": 422,
      "automatic_activation": "forbidden"
    },
    "30": {
      "meaning": "verification_failed",
      "http_status": 422,
      "automatic_activation": "forbidden"
    },
    "40": {
      "meaning": "safety_policy_refusal",
      "http_status": 409,
      "automatic_activation": "forbidden"
    },
    "70": {
      "meaning": "converter_internal_error",
      "http_status": 500,
      "automatic_activation": "forbidden"
    },
    "other": {
      "meaning": "unknown_exit_code",
      "http_status": 502,
      "automatic_activation": "forbidden"
    }
  },
  "rollback": {
    "conversion_direction": "one_way",
    "reverse_conversion": "forbidden",
    "legacy_source_retained": true,
    "catalogue_activation": "single_atomic_settings_replacement_after_strict_v2_validation",
    "activation_compare_and_swap": "active_workspace_id_must_equal_conversion_source_id",
    "activation_identity_guard": "held_directory_and_store_handles_plus_identity_revalidation_before_and_after_final_v2_validation",
    "activated_store_identity": "sha256_of_the_exact_handle_content_stable_across_final_v2_validation",
    "activated_store_consumption": "persisted_sha256_revalidated_fail_closed_before_every_linked_workspace_path_resolution",
    "legacy_catalogue_compatibility": "entries_without_store_content_sha256_keep_preexisting_reader_preflight",
    "previous_workspace_unlinked": false,
    "restore_action": "reactivate_previous_linked_workspace"
  },
  "renderer": {
    "transition_capability": "workspace_transition_status_route",
    "conversion_capability": "legacy_workspace_conversion_route",
    "conversion_requires_configured_python_library_host": true,
    "fallback_after_native_selection": "none"
  },
  "compatibility_exceptions": {
    "STU-CONV-SYNC-001": {
      "status": "approved",
      "scope": "legacy conversion route only",
      "difference": "bounded synchronous response instead of the legacy Python maintenance-job wrapper",
      "reason": "the Rust sidecar has no durable maintenance-job execution owner yet; the renderer already accepts the direct response",
      "bounds": "one process, 1800 seconds, bounded stdio, route-state mutex released",
      "removal_gate": "native durable maintenance-job execution contract"
    },
    "STU-CONV-UNKNOWN-001": {
      "status": "approved",
      "scope": "legacy conversion request only",
      "difference": "unknown JSON fields are rejected although legacy Pydantic ignored them",
      "reason": "security-sensitive command construction uses an explicit frozen allowlist"
    }
  }
}
